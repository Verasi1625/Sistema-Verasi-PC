            (categorias[cat] || 0) +
            Number(g.importe || 0);

    });


    resumen.innerHTML = `

        <div class="expense-summary">

            <div class="expense-summary-row">

                <span>
                    Total de gastos
                </span>

                <strong>
                    ${moneda(total)}
                </strong>

            </div>

            <div class="expense-summary-total">

                ${moneda(total)}

            </div>

