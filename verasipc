function todosLosMovimientos(){

    const movimientos=[];


    cotizaciones.forEach(c => {

        const pagos =
            obtenerPagos(c);


        pagos.forEach(p => {

            movimientos.push({

                cotizacionId:
                    c.id,

                folio:
                    c.folio,

                cliente:
                    c.clienteNombre,

                tipo:
                    p.tipo,

                monto:
                    Number(
                        p.monto || 0
                    ),

                fecha:
                    p.fecha,

                formaPago:
                    p.formaPago

            });

        });

    });


    return movimientos;

}


function datosReporte(
    inicio,
    fin
){

    return todosLosMovimientos()
        .filter(
            m =>
                m.fecha >= inicio &&
                m.fecha <= fin
        )
        .sort(
            (a,b) =>
                String(a.fecha)
                .localeCompare(
                    String(b.fecha)
                )
        );

}


