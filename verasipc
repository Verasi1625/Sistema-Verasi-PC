function totalGastos(){

    return gastos.reduce(
        (s,g) =>
            s +
            Number(g.importe || 0),
        0
    );

}


function gastosDeCotizacion(
    cotizacionId
){

    return gastos.filter(
        g =>
            g.cotizacionId ===
            cotizacionId
    );

}


function totalGastosCotizacion(
    cotizacionId
){

    return gastosDeCotizacion(
        cotizacionId
    )
    .reduce(
        (s,g) =>
            s +
            Number(g.importe || 0),
        0
    );

}


function utilidadCotizacion(c){

    return Number(c.total || 0) -
        totalGastosCotizacion(c.id);

}


