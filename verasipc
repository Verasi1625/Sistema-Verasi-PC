function actualizarPanel(){

    document
        .getElementById(
            "statClientes"
        )
        .textContent =
        clientes.length;


    document
        .getElementById(
            "statCotizaciones"
        )
        .textContent =
        cotizaciones.length;


    const porCobrar =
        cotizaciones
        .filter(
            c =>
                c.estado ===
                "Realizada"
        )
        .reduce(
            (s,c) =>
                s +
                saldoCotizacion(c),
            0
        );


    const cobrado =
        todosLosMovimientos()
        .reduce(
            (s,m) =>
                s +
                m.monto,
            0
        );


    const gastosTotal =
        totalGastos();


    const utilidad =
        cobrado -
        gastosTotal;


    document
        .getElementById(
            "statPorCobrar"
        )
        .textContent =
        moneda(porCobrar);


    document
        .getElementById(
            "statCobrado"
        )
        .textContent =
        moneda(cobrado);


    document
        .getElementById(
            "statGastos"
        )
        .textContent =
        moneda(gastosTotal);


    document
        .getElementById(
            "statUtilidad"
        )
        .textContent =
        moneda(utilidad);

}


