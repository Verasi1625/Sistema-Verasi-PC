function crearPDF(c){

    const { jsPDF } =
        window.jspdf;


    const doc =
        new jsPDF();


    let y = 18;


    doc.setFontSize(20);

    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        "VERASI PC",
        15,
        y
    );


    y += 8;


    doc.setFontSize(11);

    doc.setFont(
        "helvetica",
        "normal"
    );


    doc.text(
        "SOLUCIONES INFORMÁTICAS",
        15,
        y
    );


    y += 10;


    doc.setFontSize(14);

    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        `COTIZACIÓN ${c.folio}`,
        15,
        y
    );


    y += 8;


    doc.setFontSize(10);

    doc.setFont(
        "helvetica",
        "normal"
    );


    doc.text(
        `Cliente: ${c.clienteNombre}`,
        15,
        y
    );


    y += 6;


    doc.text(
        `Fecha: ${c.fecha}`,
        15,
        y
    );


    y += 10;


    if(c.descripcion){

        doc.setFont(
            "helvetica",
            "bold"
        );


        doc.text(
            "Descripción:",
            15,
            y
        );


        y += 5;


        doc.setFont(
            "helvetica",
            "normal"
        );


        const desc =
            doc.splitTextToSize(
                c.descripcion,
                180
            );


        doc.text(
            desc,
            15,
            y
        );


        y +=
            desc.length * 5 +
            5;

    }


    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        "Conceptos",
        15,
        y
    );


    y += 7;


    doc.setFontSize(9);


    doc.text(
        "Descripción",
        15,
        y
    );


    doc.text(
        "Cant.",
        120,
        y
    );


    doc.text(
        "Precio",
        140,
        y
    );


    doc.text(
        "Importe",
        170,
        y
    );


    y += 5;


    doc.setFont(
        "helvetica",
        "normal"
    );


    (c.partidas || [])
    .forEach(p => {

        if(y > 270){

            doc.addPage();

            y=20;

        }


        const descripcion =
            doc.splitTextToSize(
                String(
                    p.descripcion ||
                    ""
                ),
                95
            );


        doc.text(
            descripcion,
            15,
            y
        );


        doc.text(
            String(p.cantidad),
            120,
            y
        );


        doc.text(
            moneda(p.precio),
            140,
            y
        );


        doc.text(
            moneda(
                Number(p.cantidad || 0) *
                Number(p.precio || 0)
            ),
            170,
            y
        );


        y += Math.max(
            6,
            descripcion.length * 5
        );

    });


    y += 5;


    if(y > 250){

        doc.addPage();

        y=20;

    }


    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        `Subtotal: ${moneda(c.subtotal)}`,
        130,
        y
    );


    y += 6;


    doc.text(
        `IVA: ${moneda(c.iva)}`,
        130,
        y
    );


    y += 7;


    doc.setFontSize(13);


    doc.text(
        `TOTAL: ${moneda(c.total)}`,
        130,
        y
    );


    y += 12;


    doc.setFontSize(10);

    doc.setFont(
        "helvetica",
        "normal"
    );


    const pagos =
        obtenerPagos(c);


    if(pagos.length){

        doc.setFont(
            "helvetica",
            "bold"
        );


        doc.text(
            "Pagos registrados:",
            15,
            y
        );


        y += 6;


        doc.setFont(
            "helvetica",
            "normal"
        );


        pagos.forEach(p => {

            doc.text(
                `${p.tipo}: ${moneda(p.monto)} · ${p.fecha} · ${p.formaPago}`,
                15,
                y
            );


            y += 5;

        });


        y += 4;

    }


    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        `Total pagado: ${moneda(totalPagado(c))}`,
        15,
        y
    );


    y += 6;


    doc.text(
        `Saldo pendiente: ${moneda(saldoCotizacion(c))}`,
        15,
        y
    );


    return doc;

}


function exportarPDF(id){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    const doc =
        crearPDF(c);


    doc.save(
        `${c.folio}_VERASI_PC.pdf`
    );

}


/* =========================================================
   WHATSAPP
========================================================= */

async function compartirWhatsApp(id){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    const doc =
        crearPDF(c);


    const blob =
        doc.output("blob");


    const file =
        new File(
            [blob],
            `${c.folio}_VERASI_PC.pdf`,
            {
                type:
                    "application/pdf"
            }
        );


    const texto =
        `Hola, te comparto la cotización ${c.folio} de VERASI PC por ${moneda(c.total)}.`;


    try{

        if(
            navigator.share &&
            navigator.canShare &&
            navigator.canShare({
                files:[file]
            })
        ){

            await navigator.share({

                title:
                    `Cotización ${c.folio}`,

                text:texto,

                files:[file]

            });


            return;

        }

    }catch(e){

        if(
            e.name ===
            "AbortError"
        ){

            return;

        }

    }


    doc.save(
        `${c.folio}_VERASI_PC.pdf`
    );


    window.open(
        "https://wa.me/?text=" +
        encodeURIComponent(texto),
        "_blank"
    );

}


