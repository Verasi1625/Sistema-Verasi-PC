function abrirModalPago(
    id,
    tipo
){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    cotizacionPagoActual =
        id;


    tipoPagoActual =
        tipo;


    const saldo =
        saldoCotizacion(c);


    document
        .getElementById("pagoTitulo")
        .textContent =
        tipo === "Anticipo"
        ?
        "💰 Registrar anticipo"
        :
        "💳 Registrar pago";


    document
        .getElementById("pagoInfo")
        .innerHTML = `

            <div
                class="card"
                style="margin:0;background:#f9fafb;">

                <strong>
                    ${esc(c.folio)}
                </strong>

                <div class="small">
                    ${esc(c.clienteNombre)}
                </div>

                <hr>

                <div>
                    Total:
                    <strong>
                        ${moneda(c.total)}
                    </strong>
                </div>

                <div>
                    Anticipos:
                    <strong>
                        ${moneda(totalAnticipos(c))}
                    </strong>
                </div>

                <div>
                    Pagado:
                    <strong>
                        ${moneda(totalPagado(c))}
                    </strong>
                </div>

                <div
                    style="margin-top:6px;font-size:18px;">

                    Saldo:
                    <strong>
                        ${moneda(saldo)}
                    </strong>

                </div>

            </div>

        `;


    document
        .getElementById("pagoMonto")
        .value =
        saldo.toFixed(2);


    document
        .getElementById("pagoMonto")
        .max =
        saldo;


    document
        .getElementById("pagoFecha")
        .value =
        fechaHoy();


    document
        .getElementById("pagoForma")
        .value =
        "Efectivo";


    document
        .getElementById("modalPago")
        .classList
        .add("show");

}


function guardarPago(){

    if(!cotizacionPagoActual){

        alert(
            "No se encontró la cotización."
        );

        return;

    }


    const c =
        cotizaciones.find(
            x =>
                x.id ===
                cotizacionPagoActual
        );


    if(!c) return;


    let monto =
        Number(
            document
            .getElementById("pagoMonto")
            .value
        );


    const fecha =
        document
        .getElementById("pagoFecha")
        .value ||
        fechaHoy();


    const formaPago =
        document
        .getElementById("pagoForma")
        .value;


    const saldo =
        saldoCotizacion(c);


    if(!monto || monto <= 0){

        alert(
            "Escribe un monto válido."
        );

        return;

    }


    if(monto > saldo + 0.01){

        alert(
            `El monto no puede ser mayor al saldo pendiente de ${moneda(saldo)}.`
        );

        return;

    }


    if(!Array.isArray(c.pagos)){

        c.pagos=[];

    }


    const pago = {

        id:idUnico(),

        tipo:
            tipoPagoActual,

        monto,

        fecha,

        formaPago

    };


    c.pagos.push(
        pago
    );


    if(
        tipoPagoActual ===
        "Pago final"
    ){

        c.formaPago =
            formaPago;

        c.fechaPago =
            fecha;

    }


    const nuevoSaldo =
        saldoCotizacion(c);


    if(nuevoSaldo <= 0){

        c.estado =
            "Pagada";

        c.fechaPago =
            fecha;

        c.formaPago =
            formaPago;

    }


    guardarDatos();

    cerrarModal(
        "modalPago"
    );


    cotizacionPagoActual =
        null;


    renderCotizaciones();

    renderCXC();

    actualizarPanel();

    generarReporte();


    alert(
        `${tipoPagoActual} registrado por ${moneda(monto)}.`
    );

}


