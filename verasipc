<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="VERASI PC">
<meta name="theme-color" content="#111827">

<title>Bitácora Pro - Control Verasi</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
*{
    box-sizing:border-box;
    -webkit-tap-highlight-color:transparent;
}

body{
    margin:0;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
    background:#f3f4f6;
    color:#111827;
}

header{
    background:#111827;
    color:white;
    padding:18px 15px;
    text-align:center;
    position:sticky;
    top:0;
    z-index:50;
}

header h1{
    margin:0;
    font-size:21px;
}

header p{
    margin:4px 0 0;
    font-size:13px;
    opacity:.8;
}

nav{
    display:flex;
    overflow-x:auto;
    background:#1f2937;
    padding:8px;
    gap:6px;
    position:sticky;
    top:73px;
    z-index:49;
}

nav button{
    border:0;
    background:#374151;
    color:white;
    padding:10px 13px;
    border-radius:10px;
    white-space:nowrap;
    font-weight:600;
}

nav button.active{
    background:#2563eb;
}

main{
    max-width:900px;
    margin:auto;
    padding:15px;
}

section{
    display:none;
}

section.active{
    display:block;
}

.card{
    background:white;
    border-radius:15px;
    padding:16px;
    margin-bottom:15px;
    box-shadow:0 2px 10px rgba(0,0,0,.07);
}

.card h2{
    margin-top:0;
    font-size:19px;
}

label{
    display:block;
    font-weight:600;
    margin:12px 0 6px;
    font-size:14px;
}

input,
select,
textarea{
    width:100%;
    padding:12px;
    border:1px solid #d1d5db;
    border-radius:10px;
    font-size:16px;
    background:white;
}

textarea{
    min-height:80px;
    resize:vertical;
}

button{
    font-family:inherit;
    cursor:pointer;
}

.btn{
    border:0;
    border-radius:10px;
    padding:11px 14px;
    font-weight:700;
    margin:4px 3px 4px 0;
}

.btn-primary{
    background:#2563eb;
    color:white;
}

.btn-success{
    background:#16a34a;
    color:white;
}

.btn-warning{
    background:#f59e0b;
    color:#111827;
}

.btn-danger{
    background:#dc2626;
    color:white;
}

.btn-info{
    background:#0891b2;
    color:white;
}

.btn-secondary{
    background:#6b7280;
    color:white;
}

.btn-dark{
    background:#111827;
    color:white;
}

.btn-light{
    background:#e5e7eb;
    color:#111827;
}

.client-select-row{
    display:flex;
    gap:8px;
    align-items:center;
}

.client-select-row select{
    flex:1;
}

.partida{
    border:1px solid #e5e7eb;
    border-radius:12px;
    padding:12px;
    margin:10px 0;
    background:#fafafa;
}

.partida-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:8px;
}

.total-box{
    background:#111827;
    color:white;
    border-radius:14px;
    padding:15px;
    margin-top:15px;
}

.total-row{
    display:flex;
    justify-content:space-between;
    padding:4px 0;
}

.total-final{
    font-size:21px;
    font-weight:800;
    border-top:1px solid #4b5563;
    margin-top:7px;
    padding-top:9px;
}

.profit-box{
    background:#ecfdf5;
    border:1px solid #a7f3d0;
    color:#065f46;
    border-radius:14px;
    padding:15px;
    margin-top:15px;
}

.profit-box.negative{
    background:#fef2f2;
    border-color:#fecaca;
    color:#991b1b;
}

.badge{
    display:inline-block;
    padding:5px 9px;
    border-radius:999px;
    font-size:12px;
    font-weight:700;
}

.badge-pendiente{
    background:#fef3c7;
    color:#92400e;
}

.badge-aceptada{
    background:#dbeafe;
    color:#1d4ed8;
}

.badge-realizada{
    background:#dcfce7;
    color:#166534;
}

.badge-pagada{
    background:#d1fae5;
    color:#065f46;
}

.badge-anticipo{
    background:#ede9fe;
    color:#6d28d9;
}

.quote-card{
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px;
    margin-bottom:12px;
    background:white;
}

.quote-top{
    display:flex;
    justify-content:space-between;
    gap:10px;
}

.quote-title{
    font-weight:800;
}

.quote-total{
    font-size:18px;
    font-weight:800;
}

.small{
    font-size:13px;
    color:#6b7280;
}

.actions{
    margin-top:10px;
    display:flex;
    flex-wrap:wrap;
    gap:3px;
}

.stat-grid{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
}

.stat{
    background:white;
    padding:15px;
    border-radius:14px;
    box-shadow:0 2px 8px rgba(0,0,0,.06);
}

.stat-title{
    color:#6b7280;
    font-size:13px;
}

.stat-value{
    font-size:21px;
    font-weight:800;
    margin-top:4px;
}

.empty{
    text-align:center;
    padding:25px;
    color:#6b7280;
}

.modal{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.6);
    z-index:100;
    padding:15px;
    overflow:auto;
}

.modal.show{
    display:block;
}

.modal-box{
    max-width:700px;
    margin:30px auto;
    background:white;
    border-radius:18px;
    padding:18px;
}

.modal-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:10px;
}

.modal-header h2{
    margin:0;
}

.close{
    border:0;
    background:#e5e7eb;
    width:38px;
    height:38px;
    border-radius:50%;
    font-size:20px;
}

.payment-history{
    margin-top:12px;
}

.payment-item{
    border:1px solid #e5e7eb;
    border-radius:10px;
    padding:10px;
    margin:7px 0;
}

.payment-item strong{
    display:block;
}

.expense-card{
    border:1px solid #e5e7eb;
    border-radius:14px;
    padding:14px;
    margin-bottom:10px;
    background:white;
}

.expense-top{
    display:flex;
    justify-content:space-between;
    gap:10px;
}

.expense-amount{
    font-size:19px;
    font-weight:800;
    color:#dc2626;
}

.expense-category{
    display:inline-block;
    background:#fee2e2;
    color:#991b1b;
    border-radius:999px;
    padding:4px 8px;
    font-size:11px;
    font-weight:700;
    margin-top:5px;
}

.expense-summary{
    background:#111827;
    color:white;
    border-radius:14px;
    padding:15px;
}

.expense-summary-row{
    display:flex;
    justify-content:space-between;
    padding:5px 0;
}

.expense-summary-total{
    font-size:22px;
    font-weight:800;
    border-top:1px solid #4b5563;
    margin-top:7px;
    padding-top:9px;
}

hr{
    border:0;
    border-top:1px solid #e5e7eb;
    margin:15px 0;
}

table{
    width:100%;
    border-collapse:collapse;
}

th,td{
    text-align:left;
    padding:9px 6px;
    border-bottom:1px solid #e5e7eb;
    font-size:13px;
}

@media(max-width:600px){

    .client-select-row{
        align-items:stretch;
        flex-direction:column;
    }

    .client-select-row button{
        width:100%;
    }

    .stat-grid{
        grid-template-columns:1fr 1fr;
    }

    .btn{
        font-size:14px;
    }

    .quote-top,
    .expense-top{
        flex-direction:column;
    }

}
</style>
</head>

<body>

<header>
    <h1>VERASI PC</h1>
    <p>SOLUCIONES INFORMÁTICAS · Bitácora Pro</p>
</header>

<nav>

    <button onclick="mostrarSeccion('inicio',this)" class="active">
        Inicio
    </button>

    <button onclick="mostrarSeccion('clientes',this)">
        Clientes
    </button>

    <button onclick="mostrarSeccion('cotizacion',this)">
        Cotización
    </button>

    <button onclick="mostrarSeccion('historial',this)">
        Historial
    </button>

    <button onclick="mostrarSeccion('cxc',this)">
        Por cobrar
    </button>

    <button onclick="mostrarSeccion('cobranza',this)">
        Cobranza
    </button>

    <button onclick="mostrarSeccion('gastos',this)">
        💸 Gastos
    </button>

</nav>

<main>

<!-- ================= INICIO ================= -->

<section id="inicio" class="active">

    <div class="card">

        <h2>Panel de control</h2>

        <p class="small">
            Control de clientes, cotizaciones, cobranza y gastos.
        </p>

    </div>

    <div class="stat-grid">

        <div class="stat">

            <div class="stat-title">
                Clientes
            </div>

            <div class="stat-value" id="statClientes">
                0
            </div>

        </div>

        <div class="stat">

            <div class="stat-title">
                Cotizaciones
            </div>

            <div class="stat-value" id="statCotizaciones">
                0
            </div>

        </div>

        <div class="stat">

            <div class="stat-title">
                Por cobrar
            </div>

            <div class="stat-value" id="statPorCobrar">
                $0
            </div>

        </div>

        <div class="stat">

            <div class="stat-title">
                Cobrado
            </div>

            <div class="stat-value" id="statCobrado">
                $0
            </div>

        </div>

        <div class="stat">

            <div class="stat-title">
                Gastos
            </div>

            <div class="stat-value" id="statGastos">
                $0
            </div>

        </div>

        <div class="stat">

            <div class="stat-title">
                Utilidad
            </div>

            <div class="stat-value" id="statUtilidad">
                $0
            </div>

        </div>

    </div>

</section>


<!-- ================= CLIENTES ================= -->

<section id="clientes">

    <div class="card">

        <h2>Nuevo cliente</h2>

        <label>Nombre</label>

        <input
            id="clienteNombre"
            placeholder="Nombre del cliente">

        <label>Teléfono</label>

        <input
            id="clienteTelefono"
            type="tel"
            placeholder="Teléfono">

        <label>Correo</label>

        <input
            id="clienteCorreo"
            type="email"
            placeholder="Correo">

        <label>Dirección</label>

        <textarea
            id="clienteDireccion"
            placeholder="Dirección"></textarea>

        <button
            class="btn btn-success"
            onclick="guardarCliente()">

            Guardar cliente

        </button>

    </div>

    <div class="card">

        <h2>Clientes registrados</h2>

        <div id="listaClientes"></div>

    </div>

</section>


<!-- ================= COTIZACIÓN ================= -->

<section id="cotizacion">

    <div class="card">

        <h2>Nueva cotización</h2>

        <label>Cliente</label>

        <div class="client-select-row">

            <select id="cotCliente">

                <option value="">
                    Selecciona un cliente
                </option>

            </select>

            <button
                type="button"
                class="btn btn-info"
                onclick="nuevoClienteDesdeCotizacion()">

                + Nuevo cliente

            </button>

        </div>

        <label>Fecha</label>

        <input
            id="cotFecha"
            type="date">

        <label>Concepto / descripción</label>

        <textarea
            id="cotDescripcion"
            placeholder="Descripción general de la cotización"></textarea>

        <hr>

        <h3>Partidas</h3>

        <div id="partidas"></div>

        <button
            class="btn btn-primary"
            onclick="agregarPartida()">

            + Agregar partida

        </button>

        <div class="total-box">

            <div class="total-row">

                <span>Subtotal</span>

                <strong id="subtotal">
                    $0.00
                </strong>

            </div>

            <div class="total-row">

                <span>IVA</span>

                <strong id="iva">
                    $0.00
                </strong>

            </div>

            <div class="total-row total-final">

                <span>Total</span>

                <strong id="total">
                    $0.00
                </strong>

            </div>

        </div>

        <br>

        <button
            class="btn btn-success"
            onclick="guardarCotizacion()">

            Guardar cotización

        </button>

        <button
            class="btn btn-light"
            onclick="limpiarCotizacion()">

            Limpiar

        </button>

    </div>

</section>


<!-- ================= HISTORIAL ================= -->

<section id="historial">

    <div class="card">

        <h2>Historial de cotizaciones</h2>

        <div id="listaCotizaciones"></div>

    </div>

</section>


<!-- ================= CUENTAS POR COBRAR ================= -->

<section id="cxc">

    <div class="card">

        <h2>Cuentas por cobrar</h2>

        <p class="small">
            Aquí aparecen únicamente los trabajos realizados
            que todavía tienen saldo pendiente.
        </p>

        <div id="listaCXC"></div>

    </div>

</section>


<!-- ================= COBRANZA ================= -->

<section id="cobranza">

    <div class="card">

        <h2>Cobranza</h2>

        <label>Fecha inicial</label>

        <input
            id="reporteInicio"
            type="date">

        <label>Fecha final</label>

        <input
            id="reporteFin"
            type="date">

        <button
            class="btn btn-primary"
            onclick="generarReporte()">

            Generar reporte

        </button>

        <button
            class="btn btn-dark"
            onclick="reporteHoy()">

            Hoy

        </button>

    </div>

    <div class="card">

        <div id="resultadoReporte">

            <div class="empty">
                Selecciona un rango y genera el reporte.
            </div>

        </div>

    </div>

</section>


<!-- ================= GASTOS ================= -->

<section id="gastos">

    <div class="card">

        <h2>💸 Registrar gasto</h2>

        <p class="small">
            Registra los gastos de operación y relaciónalos
            con una cotización para conocer la utilidad real.
        </p>

        <label>Fecha</label>

        <input
            id="gastoFecha"
            type="date">

        <label>Cliente</label>

        <select id="gastoCliente" onchange="actualizarCotizacionesGasto()">

            <option value="">
                Gasto general / sin cliente
            </option>

        </select>

        <label>Cotización / trabajo</label>

        <select id="gastoCotizacion">

            <option value="">
                Sin cotización específica
            </option>

        </select>

        <label>Categoría</label>

        <select id="gastoCategoria">

            <option value="Gasolina">
                Gasolina
            </option>

            <option value="Material">
                Material
            </option>

            <option value="Herramienta">
                Herramienta
            </option>

            <option value="Traslado">
                Traslado
            </option>

            <option value="Comida">
                Comida
            </option>

            <option value="Refacción">
                Refacción
            </option>

            <option value="Servicio">
                Servicio
            </option>

            <option value="Otro">
                Otro
            </option>

        </select>

        <label>Concepto</label>

        <input
            id="gastoConcepto"
            placeholder="Ej. Gasolina para visita a cliente">

        <label>Importe</label>

        <input
            id="gastoImporte"
            type="number"
            min="0"
            step="0.01"
            placeholder="0.00">

        <label>Notas</label>

        <textarea
            id="gastoNotas"
            placeholder="Notas opcionales"></textarea>

        <br>

        <button
            class="btn btn-danger"
            onclick="guardarGasto()">

            💸 Guardar gasto

        </button>

        <button
            class="btn btn-light"
            onclick="limpiarGasto()">

            Limpiar

        </button>

    </div>


    <div class="card">

        <h2>Resumen de gastos</h2>

        <div id="resumenGastos"></div>

    </div>


    <div class="card">

        <h2>Gastos registrados</h2>

        <div id="listaGastos"></div>

    </div>

</section>

</main>


<!-- ================= MODAL NUEVO CLIENTE ================= -->

<div id="modalCliente" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2>Nuevo cliente</h2>

            <button
                class="close"
                onclick="cerrarModal('modalCliente')">

                ×

            </button>

        </div>

        <label>Nombre</label>

        <input id="nuevoClienteNombre">

        <label>Teléfono</label>

        <input
            id="nuevoClienteTelefono"
            type="tel">

        <label>Correo</label>

        <input
            id="nuevoClienteCorreo"
            type="email">

        <label>Dirección</label>

        <textarea id="nuevoClienteDireccion"></textarea>

        <br>

        <button
            class="btn btn-success"
            onclick="guardarClienteDesdeCotizacion()">

            Guardar y seleccionar

        </button>

        <button
            class="btn btn-light"
            onclick="cerrarModal('modalCliente')">

            Cancelar

        </button>

    </div>

</div>


<!-- ================= MODAL DETALLE ================= -->

<div id="modalDetalle" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2 id="detalleTitulo">
                Cotización
            </h2>

            <button
                class="close"
                onclick="cerrarModal('modalDetalle')">

                ×

            </button>

        </div>

        <div id="detalleContenido"></div>

        <hr>

        <button
            id="detallePDF"
            class="btn btn-danger">

            📄 PDF

        </button>

        <button
            id="detalleWhatsApp"
            class="btn btn-success">

            📲 WhatsApp

        </button>

        <button
            class="btn btn-light"
            onclick="cerrarModal('modalDetalle')">

            Cerrar

        </button>

    </div>

</div>


<!-- ================= MODAL PAGO ================= -->

<div id="modalPago" class="modal">

    <div class="modal-box">

        <div class="modal-header">

            <h2 id="pagoTitulo">
                Registrar pago
            </h2>

            <button
                class="close"
                onclick="cerrarModal('modalPago')">

                ×

            </button>

        </div>

        <div id="pagoInfo"></div>

        <label>Monto</label>

        <input
            id="pagoMonto"
            type="number"
            step="0.01"
            min="0">

        <label>Fecha</label>

        <input
            id="pagoFecha"
            type="date">

        <label>Forma de pago</label>

        <select id="pagoForma">

            <option value="Efectivo">
                Efectivo
            </option>

            <option value="Tarjeta">
                Tarjeta
            </option>

            <option value="Transferencia">
                Transferencia
            </option>

        </select>

        <br><br>

        <button
            class="btn btn-success"
            onclick="guardarPago()">

            💰 Registrar pago

        </button>

        <button
            class="btn btn-light"
            onclick="cerrarModal('modalPago')">

            Cancelar

        </button>

    </div>

</div>


<script>

/* =========================================================
   CONFIGURACIÓN
========================================================= */

const KEY_CLIENTES = "bitacora_clientes";

const KEY_COTIZACIONES =
    "bitacora_cotizaciones";

const KEY_GASTOS =
    "bitacora_gastos";


let clientes =
    JSON.parse(
        localStorage.getItem(KEY_CLIENTES) || "[]"
    );


let cotizaciones =
    JSON.parse(
        localStorage.getItem(KEY_COTIZACIONES) || "[]"
    );


let gastos =
    JSON.parse(
        localStorage.getItem(KEY_GASTOS) || "[]"
    );


let partidasActuales = [];

let cotizacionPagoActual = null;

let tipoPagoActual = "Pago";


/* =========================================================
   UTILIDADES
========================================================= */

function guardarDatos(){

    localStorage.setItem(
        KEY_CLIENTES,
        JSON.stringify(clientes)
    );

    localStorage.setItem(
        KEY_COTIZACIONES,
        JSON.stringify(cotizaciones)
    );

    localStorage.setItem(
        KEY_GASTOS,
        JSON.stringify(gastos)
    );

}


function moneda(valor){

    return Number(valor || 0).toLocaleString(
        "es-MX",
        {
            style:"currency",
            currency:"MXN"
        }
    );

}


function fechaHoy(){

    const d = new Date();

    const y =
        d.getFullYear();

    const m =
        String(d.getMonth()+1)
        .padStart(2,"0");

    const day =
        String(d.getDate())
        .padStart(2,"0");

    return `${y}-${m}-${day}`;

}


function esc(texto){

    return String(texto ?? "")
        .replace(/&/g,"&amp;")
        .replace(/</g,"&lt;")
        .replace(/>/g,"&gt;")
        .replace(/"/g,"&quot;")
        .replace(/'/g,"&#039;");

}


function idUnico(){

    return Date.now().toString() +
        Math.random()
        .toString(36)
        .substring(2,8);

}


function cerrarModal(id){

    document
        .getElementById(id)
        .classList
        .remove("show");

}


/* =========================================================
   NAVEGACIÓN
========================================================= */

function mostrarSeccion(id, boton){

    document
        .querySelectorAll("section")
        .forEach(s =>
            s.classList.remove("active")
        );


    document
        .getElementById(id)
        .classList
        .add("active");


    document
        .querySelectorAll("nav button")
        .forEach(b =>
            b.classList.remove("active")
        );


    if(boton){

        boton.classList.add("active");

    }


