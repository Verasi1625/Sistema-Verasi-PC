                    Efectivo
                </div>

                <div class="stat-value">
                    ${moneda(efectivo)}
                </div>

            </div>

            <div class="stat">

                <div class="stat-title">
                    Tarjeta
                </div>

                <div class="stat-value">
                    ${moneda(tarjeta)}
                </div>

            </div>

            <div class="stat">

                <div class="stat-title">
                    Transferencia
                </div>

                <div class="stat-value">
                    ${moneda(transferencia)}
                </div>

            </div>

        </div>

        <br>

        ${
            datos.length
            ?
            `

            <h3>
                Movimientos
            </h3>

            <div style="overflow-x:auto;">

                <table>

                    <thead>

                        <tr>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Folio
                            </th>

                            <th>
