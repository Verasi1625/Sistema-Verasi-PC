function exportarReportePDF(){

    const inicio =
        document
        .getElementById(
            "reporteInicio"
        )
        .value;


    const fin =
        document
        .getElementById(
            "reporteFin"
        )
        .value;


    if(!inicio || !fin){

        alert(
            "Selecciona el periodo."
        );

        return;

    }


    const datos =
        datosReporte(
            inicio,
            fin
        );


    const { jsPDF } =
        window.jspdf;


    const doc =
        new jsPDF();


    let y=18;


    doc.setFontSize(20);

    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        "VERASI PC",
        15,
        y
    );


    y+=7;


    doc.setFontSize(11);

    doc.setFont(
        "helvetica",
        "normal"
    );


    doc.text(
        "SOLUCIONES INFORMÁTICAS",
        15,
        y
    );


    y+=10;


    doc.setFontSize(15);

    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        "REPORTE DE COBRANZA",
        15,
        y
    );


    y+=7;


    doc.setFontSize(10);

    doc.setFont(
        "helvetica",
        "normal"
    );


    doc.text(
        `Periodo: ${inicio} al ${fin}`,
        15,
        y
    );


    y+=10;


    const total =
        datos.reduce(
            (s,x) =>
                s+x.monto,
            0
        );


    const efectivo =
        datos
        .filter(
            x =>
                x.formaPago ===
                "Efectivo"
        )
        .reduce(
            (s,x) =>
                s+x.monto,
            0
        );


    const tarjeta =
        datos
        .filter(
            x =>
                x.formaPago ===
                "Tarjeta"
        )
        .reduce(
            (s,x) =>
                s+x.monto,
            0
        );


    const transferencia =
        datos
        .filter(
            x =>
                x.formaPago ===
                "Transferencia"
        )
        .reduce(
            (s,x) =>
                s+x.monto,
            0
        );


    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        `TOTAL COBRADO: ${moneda(total)}`,
        15,
        y
    );


    y+=6;


    doc.setFont(
        "helvetica",
        "normal"
    );


    doc.text(
        `Efectivo: ${moneda(efectivo)}`,
        15,
        y
    );


    y+=5;


    doc.text(
        `Tarjeta: ${moneda(tarjeta)}`,
        15,
        y
    );


    y+=5;


    doc.text(
        `Transferencia: ${moneda(transferencia)}`,
        15,
        y
    );


    y+=10;


    doc.setFont(
        "helvetica",
        "bold"
    );


    doc.text(
        "Movimientos",
        15,
        y
    );


    y+=7;


    doc.setFontSize(8);


    doc.text(
        "Fecha",
        15,
        y
    );


    doc.text(
        "Folio",
        40,
        y
    );


    doc.text(
        "Cliente",
        70,
        y
    );


    doc.text(
        "Tipo",
        125,
        y
    );


    doc.text(
        "Forma",
        150,
        y
    );


    doc.text(
        "Monto",
        180,
        y
    );


    y+=5;


    doc.setFont(
        "helvetica",
        "normal"
    );


    datos.forEach(x => {

        if(y > 275){

            doc.addPage();

            y=20;

        }


        doc.text(
            String(x.fecha),
            15,
            y
        );


        doc.text(
            String(x.folio),
            40,
            y
        );


        const cliente =
            doc.splitTextToSize(
                String(
                    x.cliente ||
                    ""
                ),
                48
            );


        doc.text(
            cliente,
            70,
            y
        );


        doc.text(
            String(x.tipo),
            125,
            y
        );


        doc.text(
            String(x.formaPago),
            150,
            y
        );


        doc.text(
            moneda(x.monto),
            180,
            y
        );


        y += Math.max(
            5,
            cliente.length*4
        );

    });


    doc.save(
        `Reporte_Cobranza_${inicio}_${fin}.pdf`
    );

}


