/* =========================================================
   PAGOS / ANTICIPOS
========================================================= */

function obtenerPagos(c){

    if(Array.isArray(c.pagos)){

        return c.pagos;

    }


    const pagos = [];


    if(
        c.estado === "Pagada" &&
        c.formaPago &&
        c.fechaPago
    ){

        pagos.push({

            id:"legacy-"+c.id,

            tipo:"Pago final",

            monto:
                Number(c.total || 0),

            fecha:
                c.fechaPago,

            formaPago:
                c.formaPago

        });

    }


    return pagos;

}


function totalPagado(c){

    return obtenerPagos(c)
        .reduce(
            (s,p) =>
                s +
                Number(p.monto || 0),
            0
        );

}


function saldoCotizacion(c){

    return Math.max(
        0,
        Number(c.total || 0) -
        totalPagado(c)
    );

}


function totalAnticipos(c){

    return obtenerPagos(c)
        .filter(
            p => p.tipo === "Anticipo"
        )
        .reduce(
            (s,p) =>
                s +
                Number(p.monto || 0),
            0
        );

}


/* =========================================================
   ACEPTAR COTIZACIÓN
========================================================= */

function aceptarCotizacion(id){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    c.estado =
        "Aceptada";


    if(!Array.isArray(c.pagos)){

        c.pagos = [];

    }


    guardarDatos();

    renderCotizaciones();

    actualizarPanel();

    alert(
        `La cotización ${c.folio} fue aceptada.`
    );

}


/* =========================================================
   REGISTRAR ANTICIPO
========================================================= */

function registrarAnticipo(id){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    if(c.estado !== "Aceptada"){

        alert(
            "El anticipo se puede registrar cuando la cotización está aceptada."
        );

        return;

    }


    const saldo =
        saldoCotizacion(c);


    if(saldo <= 0){

        alert(
            "Esta cotización ya está liquidada."
        );

        return;

    }


    abrirModalPago(
        id,
        "Anticipo"
    );

}


/* =========================================================
   MARCAR REALIZADA
========================================================= */

function marcarRealizada(id){

    const c =
        cotizaciones.find(
            x => x.id === id
        );


    if(!c) return;


    c.estado =
        "Realizada";


    if(!Array.isArray(c.pagos)){

        c.pagos=[];

    }


    if(saldoCotizacion(c) <= 0){

        c.estado =
            "Pagada";


        if(!c.fechaPago){

            c.fechaPago =
                fechaHoy();

        }

    }


    guardarDatos();

    renderCotizaciones();

    renderCXC();

    actualizarPanel();


    alert(
        `La cotización ${c.folio} quedó como realizada.`
    );

}


