    let cotizacionFolio = "";


    if(cotizacionId){

        const cotizacion =
            cotizaciones.find(
                c =>
                    c.id ===
                    cotizacionId
            );


        if(cotizacion){

            cotizacionFolio =
                cotizacion.folio;

            if(!clienteId){

                clienteNombre =
                    cotizacion.clienteNombre;

            }

        }

    }


    const gasto = {

        id:idUnico(),

        fecha,

        clienteId:
            clienteId || "",

        clienteNombre,

        cotizacionId:
            cotizacionId || "",

        cotizacionFolio,

        categoria,

        concepto,

        importe,

        notas

    };


    gastos.push(
        gasto
    );


    guardarDatos();


    limpiarGasto();

    renderGastos();

    actualizarPanel();


