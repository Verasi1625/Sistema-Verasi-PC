function siguienteFolio(){

    let max = 0;


    cotizaciones.forEach(c => {

        const numero =
            parseInt(
                String(c.folio || "")
                .replace(/\D/g,"")
            ) || 0;


        if(numero > max){

            max = numero;

        }

    });


    return "COT-" +
        String(max + 1)
        .padStart(4,"0");

}


function prepararCotizacion(){

    partidasActuales = [];


    document
        .getElementById("cotFecha")
        .value =
        fechaHoy();


    document
        .getElementById("cotDescripcion")
        .value="";


    renderPartidas();

}


function agregarPartida(){

    partidasActuales.push({

        id:idUnico(),

        descripcion:"",

        cantidad:1,

        precio:0

    });


    renderPartidas();

}


function eliminarPartida(id){

    partidasActuales =
        partidasActuales
        .filter(
            p => p.id !== id
        );


    renderPartidas();

}


function actualizarPartida(
    id,
    campo,
    valor
){

    const p =
        partidasActuales
        .find(
            x => x.id === id
        );


    if(!p) return;


    if(campo === "descripcion"){

        p.descripcion =
            valor;

    }


    if(campo === "cantidad"){

        p.cantidad =
            Number(valor) || 0;

    }


    if(campo === "precio"){

        p.precio =
            Number(valor) || 0;

    }


    calcularTotales();

}


function renderPartidas(){

    const cont =
        document
        .getElementById("partidas");


    if(!partidasActuales.length){

        cont.innerHTML =
            `<div class="empty">
                Agrega una partida a la cotización.
            </div>`;


        calcularTotales();

        return;

    }


    cont.innerHTML =
        partidasActuales
        .map((p,i) => `

        <div class="partida">

            <div class="partida-header">

                <strong>
                    Partida ${i+1}
                </strong>

                <button
                    class="btn btn-danger"
                    onclick="eliminarPartida('${p.id}')">

                    Eliminar

                </button>

            </div>

            <label>
                Descripción
            </label>

            <input
                value="${esc(p.descripcion)}"
                oninput="actualizarPartida(
                    '${p.id}',
                    'descripcion',
                    this.value
                )">

            <label>
                Cantidad
            </label>

            <input
                type="number"
                min="0"
                step="1"
                value="${p.cantidad}"
                oninput="actualizarPartida(
                    '${p.id}',
                    'cantidad',
                    this.value
                )">

            <label>
                Precio unitario
            </label>

            <input
                type="number"
                min="0"
                step="0.01"
                value="${p.precio}"
                oninput="actualizarPartida(
                    '${p.id}',
                    'precio',
                    this.value
                )">

            <div
                style="margin-top:8px;text-align:right;font-weight:800;">

                Importe:
                ${moneda(
                    Number(p.cantidad || 0) *
                    Number(p.precio || 0)
                )}

            </div>

        </div>

    `)
    .join("");


    calcularTotales();

}


function calcularTotales(){

    let subtotal = 0;


    partidasActuales.forEach(p => {

        subtotal +=
            Number(p.cantidad || 0) *
            Number(p.precio || 0);

    });


    const iva =
        subtotal * 0.16;


    const total =
        subtotal + iva;


    document
        .getElementById("subtotal")
        .textContent =
        moneda(subtotal);


    document
        .getElementById("iva")
        .textContent =
        moneda(iva);


    document
        .getElementById("total")
        .textContent =
        moneda(total);


    return {
        subtotal,
        iva,
        total
    };

}


